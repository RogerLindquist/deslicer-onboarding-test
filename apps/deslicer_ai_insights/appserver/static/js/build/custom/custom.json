{"visualizations": {"agent_logs_title_viz": {"type": "splunk.markdown", "options": {"markdown": "## Agent & internal logs", "fontSize": "large"}}, "agent_logs_desc_viz": {"type": "splunk.markdown", "options": {"markdown": "Errors and warnings from the Deslicer AI Insights agent (scripted input), collector binary, and Splunk internal logs. Agent output uses logfmt: `timestamp=... level=error|warn msg=\"...\"`.", "customFontSize": 12}}, "agent_errors_count_viz": {"type": "splunk.line", "options": {"xAxisVisibility": "hide", "xAxisTitleText": "Time", "yAxisTitleText": "Count", "seriesColors": ["#c9211e", "#ec7d31"]}, "title": "Agent & app errors over time", "dataSources": {"primary": "agent_errors_count_ds"}}, "agent_errors_list_viz": {"type": "splunk.events", "options": {}, "dataSources": {"primary": "agent_errors_list_ds"}}, "exec_errors_label_viz": {"type": "splunk.markdown", "options": {"markdown": "### Splunk ExecProcessor errors (scripted input)", "fontSize": "default"}}, "exec_errors_list_viz": {"type": "splunk.events", "options": {}, "dataSources": {"primary": "exec_errors_list_ds"}}, "agent_output_label_viz": {"type": "splunk.markdown", "options": {"markdown": "### Recent agent output (all levels)", "fontSize": "default"}}, "agent_output_list_viz": {"type": "splunk.events", "options": {}, "dataSources": {"primary": "agent_output_list_ds"}}}, "dataSources": {"agent_errors_count_ds": {"type": "ds.search", "options": {"query": "index=_internal ( (sourcetype=deslicer:insights:node AND (_raw=*level=error* OR _raw=*level=warn*) ) OR (source=*deslicer_ai_insights* log_level=ERROR) ) | timechart count as Errors", "queryParameters": {"earliest": "$agent_logs_time.earliest$", "latest": "$agent_logs_time.latest$"}}}, "agent_errors_list_ds": {"type": "ds.search", "options": {"query": "index=_internal ( (sourcetype=deslicer:insights:node AND (_raw=*level=error* OR _raw=*level=warn*) ) OR (source=*deslicer_ai_insights* log_level=ERROR) ) | sort -_time", "queryParameters": {